{
  "rules": {
    ".read": false,
    ".write": false,
    "board": {
      ".read": "auth != null && query.orderByChild == 'tr' && query.limitToLast <= 100",
      ".indexOn": [
        "tr"
      ],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['n', 'av', 'c', 'g', 'r', 'b', 'tr', 't']) && newData.child('tr').val() <= newData.child('b').val() * (newData.child('sk').isNumber() ? newData.child('sk').val() : 1) + (newData.child('ar').isNumber() ? newData.child('ar').val() : 0) && (!data.exists() ? (newData.child('b').val() <= 1000 && newData.child('tr').val() <= 3000 && (!newData.child('ar').isNumber() || newData.child('ar').val() <= 3000) && newData.child('c').val() <= 200000 && newData.child('g').val() <= 20000 && newData.child('r').val() <= 2000) : (now - data.child('t').val() >= 1000 && newData.child('b').val() - data.child('b').val() <= (now - data.child('t').val()) * 0.06 + 30 && newData.child('tr').val() - data.child('tr').val() <= (now - data.child('t').val()) * 0.1 + 100 && (!newData.child('ar').isNumber() || newData.child('ar').val() - (data.child('ar').isNumber() ? data.child('ar').val() : 0) <= (now - data.child('t').val()) * 0.1 + 100) && newData.child('c').val() - data.child('c').val() <= (now - data.child('t').val()) * 1 + 100000 && newData.child('g').val() - data.child('g').val() <= (now - data.child('t').val()) * 0.05 + 5000 && newData.child('r').val() - data.child('r').val() <= (now - data.child('t').val()) * 0.005 + 500))",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16 && !newData.val().matches(/^ /) && !newData.val().matches(/ $/) && !newData.val().matches(/  /) && !newData.val().matches(/[\u0001-\u001f\u007f-\u00a0\u00ad\u00a1-\u00a9\u00ab-\u00b4\u00b6-\u00b9\u00bb-\u00bf\u00d7\u00f7\u034f\u061c\u115f\u1160\u1680\u17b4\u17b5\u180b-\u180f\u2000-\u202f\u205f-\u206f\u2190-\u2bff\u2800\u3000\u3164\ud800-\udfff\ufe00-\ufe0f\ufeff\uffa0\ufff0-\uffff!-\\/:-@\\[-\\^`{-~]/)"
        },
        "av": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 44"
        },
        "fr": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 44"
        },
        "ti": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 44"
        },
        "c": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "g": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "r": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "b": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999"
        },
        "tr": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "sk": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "pl": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "ar": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['p', 't']) && (!data.exists() || now - data.child('t').val() >= 1000)",
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 30000"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || now - data.child('t').val() > 7200000)",
        ".validate": "$code.matches(/^[A-Z0-9]{4,6}$/) && newData.hasChildren(['host', 't']) && newData.child('host').val() === auth.uid && newData.child('t').val() === now",
        "$other": {
          ".validate": "$other === 'host' || $other === 't'"
        }
      }
    },
    "sig": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$msg": {
          ".write": "auth != null && (auth.uid === $to || auth.uid === $msg)",
          ".validate": "newData.hasChildren(['from', 'type', 'sdp']) && newData.child('from').val() === auth.uid && (newData.child('type').val() === 'offer' || newData.child('type').val() === 'answer') && newData.child('sdp').isString() && newData.child('sdp').val().length <= 20000",
          "$other": {
            ".validate": "$other === 'from' || $other === 'type' || $other === 'sdp'"
          }
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['d', 's', 't'])",
        "d": {
          ".validate": "newData.isString() && newData.val().length <= 400000"
        },
        "s": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 86400000"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "fcode": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
        ".validate": "$code.matches(/^[A-Za-z0-9]{7}$/) && newData.hasChildren(['u', 't'])",
        "u": {
          ".validate": "newData.isString()"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "freq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && $from !== $to && (auth.uid === $from || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['n', 'c', 't']) && (!data.exists() || now - data.child('t').val() >= 2000)",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16 && !newData.val().matches(/^ /) && !newData.val().matches(/ $/) && !newData.val().matches(/  /) && !newData.val().matches(/[\u0001-\u001f\u007f-\u00a0\u00ad\u00a1-\u00a9\u00ab-\u00b4\u00b6-\u00b9\u00bb-\u00bf\u00d7\u00f7\u034f\u061c\u115f\u1160\u1680\u17b4\u17b5\u180b-\u180f\u2000-\u202f\u205f-\u206f\u2190-\u2bff\u2800\u3000\u3164\ud800-\udfff\ufe00-\ufe0f\ufeff\uffa0\ufff0-\uffff!-\\/:-@\\[-\\^`{-~]/)"
          },
          "av": {
            ".validate": "newData.isString() && newData.val().length <= 44"
          },
          "c": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{7}$/)"
          },
          "ok": {
            ".validate": "newData.isBoolean()"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pres": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 'st', 't']) && (!data.exists() || now - data.child('t').val() >= 1000)",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16 && !newData.val().matches(/^ /) && !newData.val().matches(/ $/) && !newData.val().matches(/  /) && !newData.val().matches(/[\u0001-\u001f\u007f-\u00a0\u00ad\u00a1-\u00a9\u00ab-\u00b4\u00b6-\u00b9\u00bb-\u00bf\u00d7\u00f7\u034f\u061c\u115f\u1160\u1680\u17b4\u17b5\u180b-\u180f\u2000-\u202f\u205f-\u206f\u2190-\u2bff\u2800\u3000\u3164\ud800-\udfff\ufe00-\ufe0f\ufeff\uffa0\ufff0-\uffff!-\\/:-@\\[-\\^`{-~]/)"
        },
        "av": {
          ".validate": "newData.isString() && newData.val().length <= 44"
        },
        "st": {
          ".validate": "newData.isString() && newData.val().matches(/^(menu|play|off)$/)"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        },
        "fr": {
          ".validate": "newData.isString() && newData.val().length <= 44"
        },
        "ti": {
          ".validate": "newData.isString() && newData.val().length <= 44"
        },
        "b": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999"
        },
        "tr": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "sk": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "c": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "g": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        }
      }
    },
    "sm": {
      "s": {
        ".read": "auth != null",
        ".indexOn": [
          "ts"
        ],
        "$id": {
          ".write": "auth != null && (data.exists() ? data.child('u').val() === auth.uid : newData.child('u').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['u','j','ts']) && newData.child('u').val() === auth.uid)",
          "u": {
            ".validate": "newData.isString()"
          },
          "j": {
            ".validate": "newData.isString() && newData.val().length <= 60000"
          },
          "ts": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "c": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() - (data.exists() ? data.val() : 0) <= 1 && (data.exists() ? data.val() : 0) - newData.val() <= 1"
        }
      },
      "l": {
        "$id": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      },
      "u": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 24"
        }
      },
      "pl": {
        "$uid": {
          ".read": "auth != null",
          "$liker": {
            ".write": "auth != null && auth.uid === $liker && $liker !== $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      },
      "v": {
        "$round": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        }
      }
    },
    "push": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['k', 't'])",
        "k": {
          ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 400"
        },
        "l": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "d": {
          ".validate": "newData.isBoolean()"
        },
        "f": {
          ".validate": "newData.isBoolean()"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "lf": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "r": {
          ".validate": "newData.isBoolean()"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -840 && newData.val() <= 840"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "w": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
        },
        "a": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
        },
        "g": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
        },
        "c": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
        },
        "s": {
          ".validate": "newData.hasChildren()"
        }
      }
    },
    "clubs": {
      "$cid": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('i/o').val() === auth.uid && !newData.exists()",
        ".validate": "$cid.matches(/^[a-z0-9]{7}$/)",
        "i": {
          ".write": "auth != null && (!data.exists() ? newData.child('o').val() === auth.uid : data.child('o').val() === auth.uid)",
          ".validate": "newData.hasChildren(['nm', 'bd', 'ty', 'rq', 'o', 't'])",
          "nm": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 18"
          },
          "ds": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "bd": {
            ".validate": "newData.hasChildren()"
          },
          "ty": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
          },
          "rq": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "lg": {
            ".validate": "newData.isString() && newData.val().length <= 3"
          },
          "o": {
            ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val() || root.child('clubs/' + $cid + '/m/' + newData.val()).exists())"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "m": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (data.exists() ? newData.child('r').val() === data.child('r').val() : ((root.child('clubs/' + $cid + '/i/ty').val() === 0 && newData.child('r').val() === 0) || (root.child('clubs/' + $cid + '/i/o').val() === auth.uid && newData.child('r').val() === 3))))) || root.child('clubs/' + $cid + '/i/o').val() === auth.uid || (root.child('clubs/' + $cid + '/m/' + auth.uid + '/r').val() >= 2 && (!data.exists() || data.child('r').val() < 2) && (!newData.exists() || newData.child('r').val() < 2)))",
            ".validate": "newData.hasChildren(['n', 'tr', 'r'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "av": {
              ".validate": "newData.isString() && newData.val().length <= 44"
            },
            "fr": {
              ".validate": "newData.isString() && newData.val().length <= 44"
            },
            "tr": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "r": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && (newData.val() !== 3 || root.child('clubs/' + $cid + '/i/o').val() === $uid || newData.parent().parent().parent().child('i/o').val() === $uid)"
            },
            "j": {
              ".validate": "newData.isNumber()"
            },
            "g": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "q": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && root.child('clubs/' + $cid + '/i/ty').val() === 1) || root.child('clubs/' + $cid + '/i/o').val() === auth.uid || root.child('clubs/' + $cid + '/m/' + auth.uid + '/r').val() >= 2)",
            ".validate": "newData.hasChildren(['n', 'tr', 't'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "av": {
              ".validate": "newData.isString() && newData.val().length <= 44"
            },
            "tr": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "clubx": {
      ".read": "auth != null",
      ".indexOn": [
        "tr"
      ],
      "$cid": {
        ".write": "auth != null && root.child('clubs/' + $cid + '/i/o').val() === auth.uid",
        ".validate": "newData.hasChildren(['nm', 'n', 'tr'])",
        "nm": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 18"
        },
        "bd": {
          ".validate": "newData.hasChildren()"
        },
        "ty": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
        },
        "rq": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "lg": {
          ".validate": "newData.isString() && newData.val().length <= 3"
        },
        "n": {
          ".write": "auth != null && root.child('clubs/' + $cid + '/m/' + auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        },
        "tr": {
          ".write": "auth != null && root.child('clubs/' + $cid + '/m/' + auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000000000"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "clubchat": {
      "$cid": {
        ".read": "auth != null && root.child('clubs/' + $cid + '/m/' + auth.uid).exists()",
        ".write": "auth != null && root.child('clubs/' + $cid + '/i/o').val() === auth.uid && !newData.exists()",
        "$mid": {
          ".write": "auth != null && !data.exists() && root.child('clubs/' + $cid + '/m/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['u', 'n', 'x', 't']) && newData.child('u').val() === auth.uid",
          "u": {
            ".validate": "newData.isString()"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "x": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
