static var _cache: Dictionary = {}


static func has_icon(icon_name: String) -> bool:
	return ICONS.has(icon_name)


## Текстура иконки, увеличенная в scale раз.
static func get_icon(icon_name: String, scale: int = 1) -> Texture2D:
	var key := "%s@%d" % [icon_name, scale]
	if not _cache.has(key):
		var rows: Array = ICONS.get(icon_name, ICONS["empty_slot"])
		_cache[key] = PixelArt.make(rows, PALETTE, false, scale)
	return _cache[key]


## Пузырь с тёмным контуром, чтобы читался на любом фоне.
static func get_bubble(bubble_name: String) -> Texture2D:
	var key := "bubble_" + bubble_name
	if not _cache.has(key):
		_cache[key] = PixelArt.make(BUBBLES.get(bubble_name, BUBBLES["chat"]), PALETTE, true, 1)
	return _cache[key]


static func item_icon(item_id: String, scale: int = 1) -> Texture2D:
	return get_icon("item_" + item_id, scale)
