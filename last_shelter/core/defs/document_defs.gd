class_name DocumentDefs
extends RefCounted
## Находки: документы, записи, снаряжение и странные сигналы. Шаг за шагом рассказывают,
## что случилось той ночью. bio_hint — фраза из биографий: житель, видевший то же самое,
## узнаёт это и вспоминает ту ночь. item — найденное снаряжение уходит на склад.

const KIND_NAMES := {"document": "Документ", "recording": "Запись", "equipment": "Снаряжение", "signal": "Сигнал"}

