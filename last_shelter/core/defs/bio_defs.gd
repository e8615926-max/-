static var _gender_re: RegEx


## Подставляет формы по полу: «{работал|работала}» → нужный вариант.
static func gendered(text: String, gender: String) -> String:
	if _gender_re == null:
		_gender_re = RegEx.new()
		_gender_re.compile("\\{([^{}|]*)\\|([^{}|]*)\\}")
	return _gender_re.sub(text, "$2" if gender == "f" else "$1", true)
